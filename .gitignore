# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage/
htmlcov/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
.vite/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Databases ─────────────────────────────────────────────────────────────────
*.db
*.sqlite3
data/

# ── Simulator runtime state ───────────────────────────────────────────────────
# Persisted setpoint survives container restarts but is not source-controlled.
.setpoint_state.json

# ── Certificates and private keys ─────────────────────────────────────────────
# When TLS is added (Stage 9), generated certs go in infra/certs/ and must
# never be committed. These patterns provide the safety net.
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.jks
infra/certs/

# ── Docker volumes (if accidentally created on host) ──────────────────────────
mosquitto-data/
mosquitto-logs/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
