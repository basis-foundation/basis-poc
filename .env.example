# ─────────────────────────────────────────────────────────────────────────────
# Basis Foundation — Local Development Environment
# Copy this file to .env before running docker compose up
# ─────────────────────────────────────────────────────────────────────────────

# ── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ── API ──────────────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_EXTERNAL_URL=http://localhost:18080
KEYCLOAK_REALM=basis
KEYCLOAK_CLIENT_ID=basis-api
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
FRONTEND_URL=http://localhost:5173

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_KEYCLOAK_URL=http://localhost:18080
VITE_KEYCLOAK_REALM=basis
VITE_KEYCLOAK_CLIENT_ID=basis-frontend
VITE_API_URL=http://localhost:8000

# ── MQTT Service Credentials (Stage 6) ───────────────────────────────────────
# These are development-only credentials stored in infra/mosquitto/passwd.
# Generate the passwd file with: make mqtt-passwd  (see README)
# Change these values before deploying to any shared or production environment.
MQTT_API_USERNAME=basis-api
MQTT_API_PASSWORD=basis-api-secret
MQTT_SIMULATOR_USERNAME=basis-simulator
MQTT_SIMULATOR_PASSWORD=basis-simulator-secret

# ── Simulator ────────────────────────────────────────────────────────────────
SIMULATOR_MQTT_HOST=mosquitto
SIMULATOR_MQTT_PORT=1883
SIMULATOR_HEARTBEAT_INTERVAL=10
